{"id": "w0086", "term": "坐", "char_count": 1, "correct": "sitting", "distractors": [{"text": "being punished", "error_type": "wrong_sense", "explanation": "「坐」有「因罪获罚」义（坐法），本句只是起身坐下"}, {"text": "seated guests", "error_type": "sense_shift", "explanation": "动词误作名词；「众宾欢也」才是宾客，此处写的是动作"}, {"text": "taking seats", "error_type": "sense_shift", "explanation": "添出「依次入座」的秩序感，原文是觥筹交错间的杂乱起坐"}]}
